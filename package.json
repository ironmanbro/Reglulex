    "next": "15.5.28",
    "postgres": "3.4.9",
    "react": "~19.2.9",
    "react-dom": "~19.2.9",
    "tsx": "^4.23.15",
    "undici": "^7.30.1",
    "zod": "~3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pdf-lib": "1.17.1",
