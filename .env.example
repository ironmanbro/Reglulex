# ---------------------------------------------------------------------------
# Foreign Investment Regulatory Library — environment variables
# Copy to .env for local development. In production set these in your platform's
# secret manager. Never commit real values.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL 14+; needs the pg_trgm and unaccent extensions, available on all major managed providers)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fi_library
# disable | require | no-verify   (managed providers usually need "require")
DATABASE_SSL=disable
DATABASE_POOL_MAX=5

# --- Original-file storage: "local" (development only) or "s3" (any S3-compatible store: AWS S3, Cloudflare R2, Backblaze B2, MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- Admin access. Generate the hash with: pnpm admin:hash-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# At least 32 random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# --- Crawler behaviour
CRAWLER_USER_AGENT=FIRegLibraryBot/0.1 (+research library of Indian foreign-investment regulations)
CRAWLER_MIN_INTERVAL_MS=2000
CRAWLER_TIMEOUT_MS=45000
CRAWLER_MAX_BYTES=83886080
CRAWLER_RESPECT_ROBOTS=true
# Extra hostnames (comma-separated) the crawler may contact beyond authority domains
CRAWLER_EXTRA_ALLOWED_HOSTS=

# --- OCR (requires tesseract-ocr and poppler-utils on the worker; included in the Docker image)
OCR_ENABLED=true
OCR_LANGUAGES=eng
OCR_MAX_PAGES=60

# --- Alerts: optional Slack/Discord-compatible incoming webhook
ALERT_WEBHOOK_URL=
ALERT_FAILURE_THRESHOLD=3

# --- Site
PUBLIC_SITE_URL=http://localhost:3000
# Serve archived copies of originals (embedded viewer + download). Set false to link to official sources only.
SERVE_ORIGINAL_FILES=true
LOG_LEVEL=info

# --- Worker
WORKER_CONCURRENCY=2
WORKER_ONCE_BUDGET_MS=3000000
